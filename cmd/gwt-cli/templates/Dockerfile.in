FROM golang:1.26.5 AS build

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o {{.Name}}

FROM alpine:latest

WORKDIR /app
COPY --from=build /app/{{.Name}} .
# templates/ is embedded in the binary (see main.go); static/ is read from
# disk by ServeStatic, so it still has to be copied.
COPY --from=build /app/static ./static

ENTRYPOINT ["./{{.Name}}"]
EXPOSE {{.Port}}/tcp
