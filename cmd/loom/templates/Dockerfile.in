FROM golang:1.26.5 AS build

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o {{.Name}}

FROM alpine:latest

WORKDIR /app
# templates/ and static/ are both embedded in the binary (see main.go),
# so only the binary itself needs to be copied into the runtime image.
COPY --from=build /app/{{.Name}} .

ENTRYPOINT ["./{{.Name}}"]
EXPOSE {{.Port}}/tcp
