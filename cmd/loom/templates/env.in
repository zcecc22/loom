# Generated by `loom new` — pre-filled local-dev defaults, including a
# freshly generated CSRF_SECRET. Not committed (see .gitignore); the
# generated main.go loads this automatically, but any real environment
# variable already set always takes precedence over what's in here.
ADDR=:{{.Port}}
ENV=dev
READ_TIMEOUT=5s
READ_HEADER_TIMEOUT=2s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=10s
ALLOWED_ORIGINS=
CSRF_SECRET={{.CSRFSecret}}
