package main

import (
	"bufio"
	"embed"
	"io/fs"
	"net/http"
	"os"
	"strings"

	"{{.LoomModule}}"
)

// templatesFS and staticFS embed their directories into the binary, so
// the app runs correctly regardless of the working directory — no files
// need to ship alongside it. LoadTemplates/ServeStatic accept any
// fs.FS, so os.DirFS("templates")/os.DirFS("static") would read from
// disk instead.
//
//go:embed templates
var templatesFS embed.FS

//go:embed static
var staticFS embed.FS

// loadDotEnv sets any KEY=VALUE line found in .env into the process
// environment, but only for a key not already set — a real deployment's
// actual environment variables (or Docker's env_file:-injected ones)
// always take precedence over anything in a checked-out .env file. A
// missing .env is not an error: it's the expected case for any deployment
// that provisions its own environment instead of shipping one.
func loadDotEnv(path string) {
	f, err := os.Open(path)
	if err != nil {
		return
	}
	defer f.Close()

	scanner := bufio.NewScanner(f)
	for scanner.Scan() {
		line := strings.TrimSpace(scanner.Text())
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		key, value, ok := strings.Cut(line, "=")
		if !ok {
			continue
		}
		key = strings.TrimSpace(key)
		if _, set := os.LookupEnv(key); set {
			continue
		}
		_ = os.Setenv(key, strings.TrimSpace(value))
	}
}

func main() {
	loadDotEnv(".env")

	// New loads ADDR/ENV/*_TIMEOUT from the environment itself — see
	// .env.example for what it reads. A malformed *_TIMEOUT panics,
	// naming the offending variable.
	app := loom.New()

	if err := app.LoadTemplates(templatesFS, "templates/*.tmpl"); err != nil {
		app.Logger().Error("loom: loading templates", "err", err)
		os.Exit(1)
	}

	// SecureHeaders sets X-Content-Type-Options/X-Frame-Options/
	// Referrer-Policy; MaxBodySize caps request bodies. HSTS is only
	// correct once this app is actually served over HTTPS, so it's gated
	// on ENV=prod rather than always on.
	app.Use(app.SecureHeaders(), app.MaxBodySize(1<<20))
	if os.Getenv("ENV") == "prod" {
		app.Use(app.HSTS())
	}

	// CORS is only wired if ALLOWED_ORIGINS is set — an empty value means
	// this app is only ever called same-origin, the common case for local
	// dev, so there's nothing to configure out of the box.
	if origins := os.Getenv("ALLOWED_ORIGINS"); origins != "" {
		var allowed []string
		for _, o := range strings.Split(origins, ",") {
			if o = strings.TrimSpace(o); o != "" {
				allowed = append(allowed, o)
			}
		}
		app.Use(app.CORS(loom.CORSConfig{AllowedOrigins: allowed}))
	}

	// CSRF requires a signing secret with no safe default. loom new already
	// generated one into the git-ignored .env — see loadDotEnv above — so a
	// freshly scaffolded project runs CSRF-protected with zero setup. A
	// project checked out fresh from git has no .env (it's not committed)
	// and must provision CSRF_SECRET itself before it will start, in dev or
	// prod alike — there's no source-baked fallback to fall back to.
	secret := os.Getenv("CSRF_SECRET")
	if secret == "" {
		app.Logger().Error("loom: CSRF_SECRET is not set — copy .env.example to .env (or set CSRF_SECRET in your real environment) and restart")
		os.Exit(1)
	}
	app.Use(app.CSRF(loom.CSRFConfig{
		Secret: []byte(secret),
		Secure: os.Getenv("ENV") == "prod",
	}))

	app.GET("/", func(c *loom.Ctx) error {
		return c.JSON(http.StatusOK, loom.H{"hello": "{{.Name}}"})
	})

	app.GET("/page", func(c *loom.Ctx) error {
		token, _ := c.CSRFToken()
		return c.HTML(http.StatusOK, "index.tmpl", loom.H{"Name": "{{.Name}}", "CSRFToken": token, "Message": ""})
	})

	// Demonstrates the CSRF round-trip end to end: the form on /page embeds
	// the token GET rendered, and this handler is protected automatically
	// since CSRF is wired globally via Use.
	app.POST("/page", func(c *loom.Ctx) error {
		token, _ := c.CSRFToken()
		message := c.FormValue("message")
		return c.HTML(http.StatusOK, "index.tmpl", loom.H{"Name": "{{.Name}}", "CSRFToken": token, "Message": message})
	})

	// fs.Sub strips the "static/" prefix go:embed leaves in staticFS's
	// paths, so a URL like /static/style.css looks up "style.css" — the
	// same relative shape os.DirFS("static") would produce from disk.
	staticSub, err := fs.Sub(staticFS, "static")
	if err != nil {
		app.Logger().Error("loom: static assets", "err", err)
		os.Exit(1)
	}
	app.ServeStatic("/static/", staticSub)

	// Returning an error from a handler renders it: an *HTTPError (from
	// c.Error or c.ErrorCause) supplies the status and a client-visible
	// message, and any other error becomes a 500 whose detail stays in the
	// log rather than reaching the client.
	app.GET("/items/{id}", func(c *loom.Ctx) error {
		if c.Param("id") != "1" {
			return c.Error(http.StatusNotFound, "no such item")
		}
		return c.JSON(http.StatusOK, loom.H{"id": c.Param("id")})
	})

	if err := app.Run(); err != nil {
		app.Logger().Error("server exited with error", "err", err)
		os.Exit(1)
	}
}
