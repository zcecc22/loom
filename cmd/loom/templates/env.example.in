ADDR=:{{.Port}}
ENV=dev
READ_TIMEOUT=5s
READ_HEADER_TIMEOUT=2s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=10s

# Comma-separated list of origins allowed to make cross-origin requests.
# Empty means CORS is not wired at all — the default, safe for local
# same-origin dev.
ALLOWED_ORIGINS=

# Signs the CSRF double-submit cookie. `loom new` already generated a real
# value into .env (git-ignored, not this file) — that's what a freshly
# scaffolded project actually uses. This file documents the shape for a
# real deployment: generate your own with e.g. `openssl rand -base64 32`
# and set it in that deployment's real environment (or its own .env,
# never committed). Left empty here on purpose — CSRF_SECRET is a secret,
# never a shared default.
CSRF_SECRET=
