ADDR=:{{.Port}}
ENV=dev
READ_TIMEOUT=5s
READ_HEADER_TIMEOUT=2s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=10s

# Comma-separated list of origins allowed to make cross-origin requests.
# Empty means CORS is not wired at all — the default, safe for local
# same-origin dev.
ALLOWED_ORIGINS=

# Signs the CSRF double-submit cookie. Left empty, main.go falls back to a
# secret generated uniquely for this project at `loom new` time (fine for
# local dev, since it's baked into source, not shared with any other
# scaffolded app) — but ENV=prod requires a real CSRF_SECRET here and fails
# fast at startup without one. Generate one with e.g. `openssl rand -base64 32`.
CSRF_SECRET=
